{
  "name": "rlsok-releasegate",
  "version": "0.1.0",
  "private": true,
  "description": "Release control and execution gating for learned robot policies.",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.5.1"
  },
  "bin": {
    "rlsok": "scripts/run-rlsok.cjs"
  },
  "scripts": {
    "start": "node scripts/run-rlsok.cjs --help",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:releasegate && npm run ros2:test",
    "verify": "npm run build && npm test",
    "rlsok": "node scripts/run-rlsok.cjs",
    "test:releasegate": "node scripts/run-releasegate-tests.cjs",
    "ros2:test": "node scripts/run-ros2-reference-tests.cjs"
  },
  "dependencies": {
    "js-yaml": "^4.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.12.12",
    "typescript": "^5.4.5"
  }
}
