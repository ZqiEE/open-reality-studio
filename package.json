{
  "name": "@realitywarden/rlsok",
  "version": "0.1.0",
  "private": false,
  "description": "Release control and execution gating for learned robot policies.",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.5.1"
  },
  "bin": {
    "rlsok": "dist/apps/cli/rlsok.js"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "experimental/ros2-reference-sidecar",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:releasegate && npm run test:cloud && npm run ros2:test",
    "verify": "npm run typecheck && npm run build && npm test",
    "prepack": "npm run build",
    "package:smoke": "node scripts/package-smoke.cjs",
    "sbom": "node scripts/generate-sbom.cjs",
    "licenses": "node scripts/license-inventory.cjs",
    "rlsok": "node scripts/run-rlsok.cjs",
    "test:releasegate": "node scripts/run-rlsok.cjs --test tests/releasegate/releaseGate.test.ts",
    "test:cloud": "node scripts/run-rlsok.cjs --test tests/cloud/cloudClient.test.ts",
    "ros2:test": "node scripts/run-rlsok.cjs --test tests/ros2-reference/ros2Reference.test.ts",
    "ros2:dds-test": "node scripts/run-rlsok.cjs --test tests/ros2-dds/ros2Dds.test.ts"
  },
  "dependencies": {
    "js-yaml": "^4.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.12.12",
    "typescript": "^5.4.5"
  }
}
