{
  "apiVersion": "realitywarden.io/v1alpha1",
  "kind": "ActionContract",
  "metadata": {
    "name": "test-joint-position",
    "version": "1"
  },
  "representation": "joint_position",
  "dimension": 2,
  "jointOrder": ["joint_1", "joint_2"],
  "units": {
    "position": "radian",
    "velocity": "radian_per_second"
  },
  "parameterRanges": {
    "joint_1": { "min": -3.14, "max": 3.14 },
    "joint_2": { "min": -3.14, "max": 3.14 }
  },
  "requiredState": ["joint_position"],
  "executionMode": "single",
  "constraints": ["reject_out_of_range"]
}
